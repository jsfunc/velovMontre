# Keep summaries, normalized measurements and named watch runs in Git.
# Raw captures and the replaceable latest-watch export stay local.
/experiments/**/*.body
/experiments/**/*.headers
/experiments/watch-benchmark.json
/experiments/*.tar
/experiments/*.tar.gz

# The Gradle wrapper JAR is required and must be committed.
!gradle/wrapper/gradle-wrapper.jar
